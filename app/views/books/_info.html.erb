<h2>User info</h2>
<% if user.profile_image.attached? %>
    <%= image_tag user.profile_image, size: "100x100" %>
<% else %>
    <%= image_tag '/home/ubuntu/environment/Bookers2/app/assets/images/no_image.jpg', size: "100x100" %>
<% end %>

<table class="table">
    <tbody>
        <tr></tr>
        <tr>
            <td>name</td>
            <td><%= current_user.name %></td>
        </tr>
        <tr>
            <td>introduction</td>
            <td><%= current_user.introduction %></td>
        </tr>
    </tbody>
</table>
<div class="row">
    <%= link_to edit_user_path(user), class: "btn btn-outline-secondary btn-block" do %>
        <i class="fas fa-user-cog"></i>
    <% end %>
</div>
<h2 class="mt-3">New book</h2>
<% if @book.errors.any? %>
    <div id="error_explanation">
        <h3><%= pluralize(@book.errors.count, "error") %> errors prohibited this book from being saved:</h3>
        <ul>
            <% @book.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
        </ul>
    </div>
<% end %>
<%= form_with model: @book, local: true, data: { turbo: false } do |f| %>
    <div class="form-group">
        <%= f.label :title, "Title" %>
        <%= f.text_field :title, class: "form-control book_title" %>
    </div>
    <div class="form-group">
        <%= f.label :body, "Opinion" %>
        <%= f.text_area :body, class: "form-control book_body" %>
    </div>
    <div class="form-group">
        <%= f.submit "Create Book", class: "btn btn-success" %>
    </div>
<% end %>