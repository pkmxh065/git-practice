<div class="container px-5 px-sm-0">
    <div class="row">
        <div class="col-md-3">
            <%= render 'books/info', user: current_user, book: @book %>
        </div>
        <div class="col-md-8 offset-md-1">
            <h2>Books</h2>
            <table class="table table-inverse">
                <thead>
                    <tr>
                        <th></th>
                        <th>Title</th>
                        <th>Opinion</th>
                        <th colspan="3"></th>
                    </tr>
                </thead>
                <tbody>
                    <% @books.each do |book| %>
                        <tr>
                            <td>
                                <%= link_to user_path(book.user) do %>
                                    <%= image_tag book.user.get_profile_image(50, 50) %>
                                <% end %>
                            </td>
                            <td>
                                <%= link_to book.title, book_path(book) %>
                            </td>
                            <td>
                                <%= book.body %>
                            </td>
                            <td>
                                <% if book.favorited_by?(current_user) %>
                                    <%= link_to book_favorites_path(book), data: { turbo_method: :delete } do %>
                                        <span style="color:blue;">♥</span><%= book.favorites.count %>
                                    <% end %>
                                <% else %>
                                    <%= link_to book_favorites_path(book), data: { turbo_method: :post } do %>
                                        <span>♥</span><%= book.favorites.count %>
                                    <% end %>
                                <% end %>
                            </td>
                            <td>
                                コメント数: <%= book.coments.count %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>