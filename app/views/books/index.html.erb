
<h1>Books</h2>
<div>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Body</th>
                <th colspan="3"></th>
            </tr>
        </thead>
        <tbody>
            <%  @books.each do |book| %>
                <tr>
                    <td><%= book.title %></td>
                    <td><%= book.body %></td>
                    <td>
                        <span class="books-list-item">
                            <%= link_to "Show", book_path(book.id) %>
                        </span>
                    </td>
                    <td>
                        <span class="books-list-item">
                            <%= link_to "Edit", edit_book_path(book.id) %>
                        </span>
                    </td>
                    <td>
                        <span class="books-lis-item">
                            <%= link_to "Destroy", destroy_book_path(book.id), data: { turbo_method: :delete, turbo_confirm: "Are you sure？"} %>
                        </span>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
<div class="field_with_error">
    <% if @book.errors.any? %>
        <%= @book.errors.count %>error prohibited this book from being saved:
        <ul>
            <% @book.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
        </ul>
    <% end%>
</div>
<%= form_with model: @book, local: true do |f| %>
    <div class="field">
        <label for="book-title">Title</label>
        <%= f.text_field :title %>
    </div>
    <div class="field">
        <label for="bookp-body">Body</label>
        <%= f.text_area :body %>
    </div>
    <%= f.submit 'Create Book' %>
<% end %>
