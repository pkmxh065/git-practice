<div id="favorite_button_<%= book.id %>">
    <% if book.favorited_by?(current_user) %>
        <%= link_to book_favorites_path(book), data: { turbo_method: :delete } do %>
            <span style="color:blue;">♥</span><%= book.favorites.count %>
        <% end %>
    <% else %>
        <%= link_to book_favorites_path(book), data: { turbo_method: :post } do %>
            <span>♥</span><%= book.favorites.count %>
        <% end %>
    <% end %>
</div>