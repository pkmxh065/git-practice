<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <% if @target&.downcase == "user" %>
                <h2>Users search for</h2>
                <% if @users.present? %>
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Name</th>
                                <th colspan="4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @users.each do |user| %>
                                <tr>
                                    <td>
                                        <% if user.respond_to?(:get_profile_image) %>
                                            <%= image_tag user.get_profile_image(50, 50) %>
                                        <% end %>
                                    </td>
                                    <td><%= user.name %><td>
                                    <td>フォロー数: <%= user.followings.count %></td>
                                    <td>フォロワー数: <%= user.followers.count %></td>
                                    <td>
                                        <% if user != Current.user %>
                                            <% if Current.user.following?(user) %>
                                                <%= link_to "フォロー外す", user_relationships_path(user.id), data: { turbo_method: :delete } %>
                                            <% else %>
                                                <%= link_to "フォローする", user_relationships_path(user.id), data: { turbo_method: :post} %>
                                            <% end %>
                                        <% end %>
                                    </td>
                                    <td><%= link_to 'Show', user_path(user.id) %></td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                <% else %>
                    <div class="alert alert-wraning">一致するユーザーは見つかりませんでした。</div>
                <% end %>
            <% elsif @target&.downcase == "book" %>
                <% if @books.present? %>
                    <table>                        
                        <thead>
                            <tr>
                                <th></th>
                                <th>Title</th>
                                <th>Opinion<th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @books.each do |book| %>
                                <tr>
                                    <td>
                                        <%= link_to user_path(book.user) do %>
                                            <% if book.user.respond_to?(:get_profile_image) %>                                          
                                                <%= image_tag book.user.get_profile_image(50, 50) %>
                                            <% end %>
                                        <% end %>
                                    </td>
                                    <td><%= link_to book.title, book_path(book) %></td>                            
                                    <td><%= book.body %></td>
                                </tr>
                            <% end %>                        
                        </tbody>
                    </table>
                <% else %>  
                    <div class="alert alert-warning">一致する本は見つかりませんでした。</div>
                <% end %>                                                         
            <% end %>
        </div>
    </div>
</div>