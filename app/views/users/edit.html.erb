<div class="container">
    <div class="row">
        <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
            <h2>User info</h2>
            <% if @user.errors.any? %>
                <div id="error_explanation">
                    <h3><%= @user.errors.count %> <%= @user.errors.errors.count == 1 ? "error" : "errors" %> prohibited this obj from being saved:</h3>
                    <ul>
                        <% @user.errors.full_messages.each do |message| %>
                            <li><%= message %></li>
                        <% end %>
                    </ul>
                </div>
            <% end %>
            <%= form_with model: @user, data: { turbo: false } do |f| %>
                <div class="form-group">
                    <%= f.label :name, "Name", for: "user_name" %>
                    <%= f.text_field :name, class: "form-control name" %>
                </div>
                <div class="form-group">
                    <%= f.label :user_image, "Image" %>
                    <%= f.file_field :profile_image, class: "form-control-file user_image", accept: "image/*", id: "user_profile_image" %>
                </div>
                <div class="form-group">
                    <%= f.label :introduction, "Introduction" %>
                    <%= f.text_area :introduction, class: "form-control introduction" %>
                </div>
                <div class="form-group">
                    <%= f.submit "Update User", class: "btn btn-secondary" %>
                </div>
            <% end %>
        </div>
    </div>
</div>