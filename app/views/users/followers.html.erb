<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-1">
            <h2>Follower User</h2>
            <% if @users.exists? %>
                <table>
                    <thead>
                        <tr>
                            <th>image</th>
                            <th>name</th>
                            <th colspan="3">
                        </tr>
                    </thead>
                    <tbody>
                        <% @users.each do |user| %>
                            <tr>
                                <td><%= image_tag user.profile_image, size: "50x50" %></td>
                                <td><%= user.name %></td>
                                <td>フォロー数: <%= user.followings.count %></td>
                                <td>フォロワー数: <%= user.followers.count %></td>
                                <td><%= link_to "Show", user_path(user) %></td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            <% else %>
                <p>ユーザーはいません。</p>
            <% end %>
        </div>
    </div>
</div>