<div class="container">
    <div class="row">
        <div class="col-md-3">
            <%= render 'books/info', user: Current.user %>
        </div>
        <div class="col-md-8 offset-md-1">
            <h2>Users</h2>
            <table class="table">
                <thead>
                    <tr>
                        <th></th>
                        <th>name</th>
                        <th colspan="3"></th>
                    </tr>
                </thead>
                <tbody>
                    <% @users.each do |user| %>
                        <tr>
                            <td><%= image_tag "/home/ubuntu/environment/Bookers2/app/assets/images/no_image.jpg" %></td>
                            <td><%= user.name %></td>
                            <td><%= link_to "Show", user_path(user.id) %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>